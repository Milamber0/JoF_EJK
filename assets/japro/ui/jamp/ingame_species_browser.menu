//-----------------------------------
// Custom Player Model Browser
//-----------------------------------
{
	menuDef
	{
		name						"ingame_species_browser"
		visible					0
		fullscreen					0
		outOfBoundsClick
		rect						105 40 430 400
		focusColor					1 1 1 1
		style						1
		backcolor					0 0 0 1
		border					1
		descX						320
		descY						415
		descScale					1
		descColor					1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER
		popup

		onOpen
		{
			uiScript				"prepareSpeciesBrowser"
			uiScript				"character"
			setfocus				speciesSearch
			hide					donebutton_glow
		}

		onESC
		{
			play					"sound/interface/esc.wav"
			close					ingame_species_browser
		}

// Hide the full-screen custom editor when opened from the main Profile menu.
		itemDef
		{
			name					mainMenuBackgroundFill
			group					none
			style					WINDOW_STYLE_FILLED
			rect					-105 -40 640 480
			backcolor				0 0 .04 1
			cvarTest				ui_speciesBrowserMain
			showCvar				{ "1" }
			visible					1
			decoration
		}

		itemDef
		{
			name					mainMenuBackground
			group					none
			style					WINDOW_STYLE_SHADER
			rect					-105 -40 640 480
			background				"gfx/menus/main_background"
			forecolor				1 1 1 1
			cvarTest				ui_speciesBrowserMain
			showCvar				{ "1" }
			visible					1
			decoration
		}

// Overall window backdrop
		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_SHADER
			rect					0 0 430 400
			background				"gfx/menus/menu_box_ingame"
			forecolor				1 1 1 1
			visible					1
			decoration
		}

// Title
		itemDef
		{
			name					speciesBrowserTitle
			style					WINDOW_STYLE_SHADER
			background				"gfx/menus/menu_blendbox"
			text					"CUSTOM MODEL BROWSER"
			rect					35 5 360 28
			textalign				ITEM_ALIGN_CENTER
			textalignx				180
			textaligny				2
			outlinecolor			1 .5 .5 .5
			backcolor				0 0 0 0
			font					3
			textscale				0.9
			forecolor				.549 .854 1 1
			border					0
			bordercolor				0 0 0 0
			visible					1
			decoration
		}

// Search field
		itemDef
		{
			name					speciesSearch
			type					ITEM_TYPE_EDITFIELD
			text					"Search:"
			cvar					ui_speciesSearch
			rect					15 45 210 24
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				8
			font					2
			textscale				.7
			forecolor				1 .682 0 1
			maxChars				32
			maxPaintChars			18
			visible					1
			descText				"Filter custom character models by name"
		}

// Alphabetized model list
		itemDef
		{
			name					speciesList
			group					none
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_FILLED
			elementwidth				210
			elementheight			18
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_PLAYER_SPECIES_BROWSER
			border					1
			bordersize				1
			backcolor				.66 .66 1 .25
			bordercolor				.66 .66 1 1
			forecolor				1 1 1 1
			outlinecolor			.66 .66 1 .6
			rect					15 78 210 249
			font					2
			textscale				.8
			textaligny				14
			descText				"Select a model; use the wheel or keyboard to scroll"
			visible					1
			doubleClick
			{
				play				"sound/interface/button1.wav"
				close				ingame_species_browser
			}
		}

// Empty search result
		itemDef
		{
			name					noSpeciesResults
			text					"No custom models match your search."
			rect					25 178 190 40
			textalign				ITEM_ALIGN_CENTER
			textalignx				95
			textaligny				10
			font					2
			textscale				.7
			forecolor				1 1 1 1
			cvarTest				ui_speciesSearchCount
			showCvar				{ "0" }
			visible					1
			decoration
		}

// Live character preview
		itemDef
		{
			name					character
			group					models
			type					ITEM_TYPE_MODEL
			rect					230 60 190 270
			model_g2anim				"BOTH_WALK1"
			asset_model				"ui_char_model"
			model_angle				180
			model_g2mins				-30 -15 -14
			model_g2maxs				20 15 30
			model_rotation			50
			model_fovx				50
			model_fovy				50
			isCharacter				1
			visible					1
			decoration
		}

// Done
		itemDef
		{
			name					donebutton_glow
			group					buttonglows
			style					WINDOW_STYLE_SHADER
			rect					160 345 110 32
			background				"gfx/menus/menu_buttonback"
			forecolor				1 1 1 1
			decoration
			visible					0
		}

		itemDef
		{
			name					doneSpeciesBrowser
			group					none
			text					"DONE"
			descText				"Return to custom character options"
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					160 345 110 32
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				2
			font					2
			textscale				.9
			forecolor				1 .682 0 1
			visible					1
			action
			{
				play				"sound/interface/button1.wav"
				close				ingame_species_browser
			}
			mouseEnter
			{
				show				donebutton_glow
			}
			mouseExit
			{
				hide				donebutton_glow
			}
		}
	}
}
